module commerce_dashboard;

requires console;
denies net, fs;

struct Product {
    sku: str,
    name: str,
    unit_price_cents: i64,
    stock: i64,
}

enum OrderOutcome {
    Accepted(i64),
    Rejected(str),
}

fn price_order(product: Product, qty: i64) -> OrderOutcome {
    if qty <= 0 {
        return OrderOutcome::Rejected("quantity must be positive");
    }
    if qty > product.stock {
        return OrderOutcome::Rejected("insufficient inventory");
    }
    return OrderOutcome::Accepted(product.unit_price_cents * qty);
}

fn main() -> i64 effects(console) {
    let headphones = Product {
        sku: "PROD-1001",
        name: "Studio Monitor Headphones",
        unit_price_cents: 14900,
        stock: 42,
    };
    let keyboard = Product {
        sku: "PROD-1002",
        name: "Ergonomic Mechanical Keyboard",
        unit_price_cents: 18950,
        stock: 18,
    };

    let order_a: OrderOutcome = price_order(headphones, 2);
    let order_b: OrderOutcome = price_order(keyboard, 1);

    let mut total_cents: i64 = 0;
    match order_a {
        OrderOutcome::Accepted(sub) => {
            total_cents = total_cents + sub;
        },
        OrderOutcome::Rejected(msg) => {
            console.print("Order A rejected: " + msg);
        },
    }
    match order_b {
        OrderOutcome::Accepted(sub) => {
            total_cents = total_cents + sub;
        },
        OrderOutcome::Rejected(msg) => {
            console.print("Order B rejected: " + msg);
        },
    }

    console.print("Manifest Commerce Dashboard total (cents): " + std::conv::to_str(total_cents));
    return total_cents;
}
