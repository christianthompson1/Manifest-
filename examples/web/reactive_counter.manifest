module reactive_counter;

requires console;

struct CounterState {
    count: i64,
    step: i64,
}

fn increment(state: CounterState) -> CounterState {
    return CounterState {
        count: state.count + state.step,
        step: state.step,
    };
}

fn reset_counter(state: CounterState) -> CounterState {
    return CounterState {
        count: 0,
        step: state.step,
    };
}

fn main() -> i64 effects(console) {
    let initial = CounterState { count: 0, step: 1 };
    let after_one = increment(initial);
    let after_two = increment(after_one);
    console.print("Manifest Web Counter count: " + std::conv::to_str(after_two.count));
    let cleared = reset_counter(after_two);
    console.print("After reset: " + std::conv::to_str(cleared.count));
    return after_two.count;
}
